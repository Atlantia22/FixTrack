# Copiar como .env y completar con los valores locales
# Conexión a MySQL; por defecto localhost:3306/fixtrack con el usuario root
# DB_URL=jdbc:mysql://localhost:3306/fixtrack?serverTimezone=America/Bogota&createDatabaseIfNotExist=true
# DB_USERNAME=root
DB_PASSWORD=
# Esquema: update en desarrollo, validate en producción
# DDL_AUTO=update
# Orígenes permitidos del front, separados por coma
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# Llave AES de 32 bytes en Base64; se genera con: openssl rand -base64 32
ENCRYPTION_KEY=
# Llave HMAC del JWT de al menos 32 bytes en Base64; se genera con: openssl rand -base64 32
JWT_SECRET=
# Duración del token de sesión; por defecto 8h
# JWT_EXPIRATION=8h
# Administrador inicial: solo se usa si la base no tiene ningún administrador activo
ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@fixtrack.local
# ADMIN_DOCUMENT_NUMBER=1000000000
# Muestra el SQL en la consola para depurar; por defecto false
# SHOW_SQL=true
# Usuarios de prueba (coordinador, asesor y técnico) para desarrollo; vacío = no se crean
DEMO_USERS_PASSWORD=
# Datos de ejemplo (catálogos, clientes y órdenes) en una base vacía; exige DEMO_USERS_PASSWORD. Nunca en producción
# SEED_DATA=true
